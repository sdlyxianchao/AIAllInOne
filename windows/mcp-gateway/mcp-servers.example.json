{
  "servers": [
    {
      "name": "filesystem",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/data"],
      "env": {}
    },
    {
      "name": "github",
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "env": { "Authorization": "Bearer YOUR_GITHUB_TOKEN" }
    },
    {
      "name": "custom_http_server",
      "type": "http",
      "url": "http://host.docker.internal:9000/mcp",
      "env": {}
    }
  ]
}
