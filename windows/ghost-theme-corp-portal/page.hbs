{{!< default}}

<article class="post post--page">
    <div class="container post-container">
        {{#page}}
        {{#if @page.show_title_and_feature_image}}
            <header class="post-header">
                <h1 class="post-title">{{title}}</h1>
                <p class="post-subtitle">{{custom_excerpt}}</p>
            </header>
            {{#if feature_image}}
                <figure class="post-feature">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                </figure>
            {{/if}}
        {{/if}}
        <div class="post-content">
            {{content}}
        </div>
        {{/page}}
    </div>
</article>
