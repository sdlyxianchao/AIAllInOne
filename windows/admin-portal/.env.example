# AI Admin Center — 环境变量说明
# ⚠️ 本服务不单独读取此文件：所有配置由 docker-compose.yml 从「根目录 .env」注入
#    （compose 的 environment: 段里 `VAR=${VAR}` 引用根 .env 的值）。
#    因此改配置请改根目录 .env（模板见根 .env.example）；本文件仅列出实际用到的变量，便于排查。

# ═══ Keycloak SSO ═══
KEYCLOAK_URL=http://<服务器IP>:9090          # 由 SERVER_PUBLIC_URL 派生（compose: ${SERVER_PUBLIC_URL}:9090）
KEYCLOAK_REALM=enterprise-ai
KEYCLOAK_CLIENT_ID=AI-all-in-one-admin-portal
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ═══ 全局管理员 ═══
ADMIN_USERNAME=ai_all_in_one_admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=ai_all_in_one_admin@<公司域名>
# Ghost 后台免登录用的管理员邮箱（Ghost 实际管理员，与 Dify 同，须与 AD 全局管理员一致）
GHOST_ADMIN_EMAIL=ai_all_in_one_admin@<公司域名>
SESSION_SECRET=CHANGE_ME_RANDOM_64

# ═══ 被管理产品地址（多数由 SERVER_PUBLIC_URL 派生）═══
LITELLM_URL=http://<服务器IP>:4001
NEWAPI_URL=http://new-api:3000              # 容器内服务名
MCP_GATEWAY_URL=http://mcp-gateway:3100     # 容器内服务名
GITEA_URL=http://<服务器IP>:3002
DIFY_URL=http://<服务器IP>
GRAFANA_URL=http://<服务器IP>:3030
LANGFUSE_URL=http://<服务器IP>:3010

# ═══ 各产品凭据 / 集成 ═══
NEWAPI_ADMIN_USERNAME=ai_all_in_one_admin
NEWAPI_ADMIN_PASSWORD=CHANGE_ME
NEWAPI_DB_PASSWORD=CHANGE_ME
MCP_ADMIN_TOKEN=CHANGE_ME_RANDOM
DIFY_ADMIN_EMAIL=ai_all_in_one_admin@<公司域名>
DIFY_ADMIN_PASSWORD=CHANGE_ME
DIFY_KNOWLEDGE_API_KEY=CHANGE_ME
DIFY_DEFAULT_DATASET_ID=CHANGE_ME
LITELLM_MASTER_KEY=CHANGE_ME_RANDOM
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME

# ═══ 告警转发 ═══
# 企业 IM 告警转发（钉钉/企微/飞书机器人 webhook 地址），留空则只在 AI 管理中心内展示
#   钉钉：https://oapi.dingtalk.com/robot/send?access_token=xxx
#   企微：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   飞书：https://open.feishu.cn/open-apis/bot/v2/hook/xxx
ALERT_IM_WEBHOOK_URL=
ALERT_IM_TYPE=            # dingtalk | wecom | feishu（留空自动按 URL 识别）

# ═══ 其他 ═══
PORT=3000
