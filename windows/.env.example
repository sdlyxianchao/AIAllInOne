# ============================================
# AI Platform — Windows (Docker Desktop) Environment
# 复制为 .env 并填写真实值后再部署（本文件是脱敏模板，勿提交真实密钥）
# ============================================

# --- General ---
TZ=Asia/Shanghai
# 服务器对外地址（浏览器访问用）：IP 或域名，不含端口、不含尾斜杠。
# 所有产品入口 URL、SSO 回调等都由它派生。将来换成域名（如 https://ai.example.com）只需改这一处。
SERVER_PUBLIC_URL=http://192.168.31.117

# --- Keycloak (SSO, dev mode with H2) ---
KEYCLOAK_ADMIN=ai_all_in_one_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- NewAPI (LLM Router) ---
NEWAPI_DB_PASSWORD=CHANGE_ME
NEWAPI_ADMIN_USERNAME=ai_all_in_one_admin
NEWAPI_ADMIN_PASSWORD=CHANGE_ME
NEWAPI_SESSION_SECRET=CHANGE_ME_RANDOM_32
NEWAPI_CRYPTO_SECRET=CHANGE_ME_RANDOM_32
# NewAPI Keycloak SSO：配置为「自定义 OAuth 提供商 Keycloak」（存 NewAPI 数据库 custom_oauth_providers 表）。
# Keycloak client "newapi" 的 secret 如下（在 Keycloak 创建 client 后填入，仅供备忘）：
NEWAPI_OIDC_CLIENT_SECRET=CHANGE_ME
# ⚠️ SSO 登录的管理员默认是 common 角色（role=1），访问管理页会 403。首次部署后需把 SSO 映射的本地用户提升为 root：
#   docker exec new-api-db mysql -uroot -p... new-api -e "UPDATE users SET role=100 WHERE id=(SELECT user_id FROM user_oauth_bindings WHERE provider_user_id='<Keycloak管理员sub>');"
GLOBAL_WEB_RATE_LIMIT=999999
GLOBAL_API_RATE_LIMIT=999999
CRITICAL_RATE_LIMIT_ENABLE=false
CRITICAL_RATE_LIMIT=999999
DEFAULT_QUOTA=100
GENERATE_DEFAULT_TOKEN=true

# --- LiteLLM (LLM Proxy + PII redaction) ---
# 只填你有的 key，未填的模型在 litellm-config.yaml 里保持注释
# OPENAI_API_KEY=CHANGE_ME
# ANTHROPIC_API_KEY=CHANGE_ME
DEEPSEEK_API_KEY=CHANGE_ME
LITELLM_MASTER_KEY=CHANGE_ME_RANDOM
# LiteLLM 独立 PostgreSQL 密码（UI 登录 / 虚拟密钥 / SSO 用户持久化都需要）
LITELLM_DB_PASSWORD=CHANGE_ME_RANDOM

# --- LiteLLM Admin UI 登录（统一账号，基础认证兜底）---
UI_USERNAME=ai_all_in_one_admin
UI_PASSWORD=CHANGE_ME

# --- LiteLLM Admin UI SSO（通用 OIDC → Keycloak，可选启用）---
# 授权端点走内网 IP（浏览器跳转）；token/userinfo 走容器内 host.docker.internal 回 Keycloak。
# 启用前提：① Keycloak 建 OIDC Client "litellm"（confidential，redirect=<服务器IP>:4001/sso/callback）；
# ② 给该 client 加硬编码 claim 映射 litellm_role=proxy_admin；③ 下面填真实 secret、AUTO_SSO=true。
LITELLM_UI_CLIENT_ID=litellm
LITELLM_UI_CLIENT_SECRET=CHANGE_ME
LITELLM_UI_AUTH_ENDPOINT=http://<服务器IP>:9090/realms/enterprise-ai/protocol/openid-connect/auth
LITELLM_UI_TOKEN_ENDPOINT=http://host.docker.internal:9090/realms/enterprise-ai/protocol/openid-connect/token
LITELLM_UI_USERINFO_ENDPOINT=http://host.docker.internal:9090/realms/enterprise-ai/protocol/openid-connect/userinfo
LITELLM_UI_SCOPE=openid profile email
LITELLM_UI_ROLE_ATTR=litellm_role
LITELLM_UI_PROXY_BASE_URL=http://<服务器IP>:4001
LITELLM_UI_AUTO_SSO=true

# --- Gitea (Git + CI/CD) ---
GITEA_RUNNER_TOKEN=CHANGE_ME
# Gitea OIDC SSO（可选）：Keycloak client "gitea" 的 secret（见部署指南 Gitea SSO 章节）
GITEA_OIDC_CLIENT_SECRET=CHANGE_ME

# --- AI Admin Center (Unified admin portal) ---
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
ADMIN_USERNAME=ai_all_in_one_admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=admin@company.com
# Ghost 后台免登录用的管理员邮箱（Ghost 实际管理员，与 Dify 同，注意不是上面 ADMIN_EMAIL）
GHOST_ADMIN_EMAIL=ai_all_in_one_admin@company.com
SESSION_SECRET=CHANGE_ME_RANDOM_64

# --- MCP Gateway ---
MCP_ADMIN_TOKEN=CHANGE_ME_RANDOM

# --- Dify console API ---
DIFY_ADMIN_EMAIL=ai_all_in_one_admin@company.com
DIFY_ADMIN_PASSWORD=CHANGE_ME

# --- Dify Knowledge API（MCP Gateway search_knowledge 检索用）---
# DIFY_API_BASE：MCP Gateway 容器访问 Dify 的地址（用宿主机内网 IP，MCP Gateway 与 Dify 不在同一 Docker 网络）
DIFY_API_BASE=http://<服务器IP>/v1
DIFY_KNOWLEDGE_API_KEY=CHANGE_ME
DIFY_DEFAULT_DATASET_ID=CHANGE_ME

# --- Grafana 监控（#8 监控告警）---
GRAFANA_ADMIN_USER=ai_all_in_one_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_OAUTH_CLIENT_SECRET=CHANGE_ME

# --- Langfuse LLM 可观测（#11）---
# 生成方式见 windows-deploy-guide-v2.html 13.4
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
LANGFUSE_SALT=CHANGE_ME_openssl_rand_base64_32
LANGFUSE_POSTGRES_PASSWORD=CHANGE_ME
LANGFUSE_MINIO_USER=langfuse
LANGFUSE_MINIO_PASSWORD=CHANGE_ME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# Langfuse 项目 API Key（LiteLLM 上报用，pk/sk，首次启动后从 Langfuse 项目设置复制）
LANGFUSE_PUBLIC_KEY=CHANGE_ME_pk-lf-...
LANGFUSE_SECRET_KEY=CHANGE_ME_sk-lf-...
# Langfuse SSO（Keycloak）
LANGFUSE_KEYCLOAK_CLIENT_SECRET=CHANGE_ME
